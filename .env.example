# You normally don't need to edit this file – open http://localhost:3000/settings instead.
# Only ONE of these is needed to make your first video:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PEXELS_API_KEY=
GEMINI_API_KEY=

# One-click publish (optional)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram / Facebook (optional; they need a public video URL, so Cloudinary is required for them)
META_APP_ID=
META_APP_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PORT=3000
